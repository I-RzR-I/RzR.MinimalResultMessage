<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0;net48</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="TestData.fs" />
    <Compile Include="ResultMessageTests.fs" />
    <Compile Include="MinimalResultTests.fs" />
    <Compile Include="MinimalResultInterfaceTests.fs" />
    <Compile Include="ConversionTests.fs" />
    <Compile Include="ExtensionTests.fs" />
    <Compile Include="FunctionalTests.fs" />
  </ItemGroup>
  <ItemGroup><PackageReference Include="xunit.v3" Version="4.0.1" /></ItemGroup>
  <ItemGroup><ProjectReference Include="..\..\RzR.MinimalResultMessage\RzR.MinimalResultMessage.fsproj" /></ItemGroup>
</Project>
